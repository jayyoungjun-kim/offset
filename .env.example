GOOGLE_APPS_SCRIPT_URL=
FORM_SUBMIT_SECRET=
NEXT_PUBLIC_CHANNEL_PLUGIN_KEY=

# Google OAuth web application. Keep secrets in .env.local / hosting environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the origin used in the browser (no trailing slash).
AUTH_ORIGIN=http://localhost:3000
# Comma-separated verified Google account emails; never exposed to the client.
ADMIN_EMAILS=
